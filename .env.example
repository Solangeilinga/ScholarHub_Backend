# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}"

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Email (Resend — https://resend.com)
# 1. Créer un compte, récupérer une clé API (gratuit : 100 emails/jour, 3000/mois)
# 2. Pour tester tout de suite sans configurer de domaine : EMAIL_FROM=onboarding@resend.dev
#    (fonctionne immédiatement mais look moins pro — pensez à vérifier votre propre domaine avant le vrai lancement)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# Cloudinary (Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (CORS + liens dans les emails de reset password / vérification email)
# Doit pointer vers le panel admin (Netlify), qui héberge les pages publiques
# /reset-password/:token et /verify-email/:token
FRONTEND_URL=https://votre-panel-admin.netlify.app
# Autres origines web autorisées, séparées par des virgules (ex. site vitrine)
CORS_ORIGINS=

# IA — utilisée par le chatbot ScholarBot ET l'extraction IA du scraping
# (Groq en priorité, Gemini en secours automatique si Groq échoue)
# Groq : console.groq.com -> clé gratuite, très rapide (Llama 3.3 70B)
# Gemini : aistudio.google.com/apikey -> clé gratuite
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Google Custom Search (découverte de nouvelles pages de bourses)
# 1. Créer une clé API : console.cloud.google.com -> activer "Custom Search API"
# 2. Créer un moteur : programmablesearchengine.google.com -> configurer sur "tout le web"
GOOGLE_CSE_API_KEY=your_google_cse_api_key
GOOGLE_CSE_CX=your_google_cse_engine_id

# Plafond de sécurité : nombre max de nouvelles pages analysées par exécution du scraping
SCRAPER_MAX_CANDIDATES=150
