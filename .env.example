# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}"

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@scholarhub.africa

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# Cloudinary (Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3001

# OpenAI (chatbot ScholarBot + extraction IA du scraping)
OPENAI_API_KEY=your_openai_api_key

# Google Custom Search (découverte de nouvelles pages de bourses)
# 1. Créer une clé API : console.cloud.google.com -> activer "Custom Search API"
# 2. Créer un moteur : programmablesearchengine.google.com -> configurer sur "tout le web"
GOOGLE_CSE_API_KEY=your_google_cse_api_key
GOOGLE_CSE_CX=your_google_cse_engine_id

# Plafond de sécurité : nombre max de nouvelles pages analysées par exécution du scraping
SCRAPER_MAX_CANDIDATES=150
