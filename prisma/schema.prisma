generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String         @id @default(uuid())
  name                 String
  email                String         @unique
  passwordHash         String
  country              String?
  nationality          String?
  level                StudyLevel?
  fields               String[]
  languages            String[]
  bio                  String?
  avatarUrl            String?
  role                 Role           @default(USER)
  isVerified           Boolean        @default(false)
  verificationToken    String?
  resetPasswordToken   String?
  notificationsEnabled Boolean        @default(true)
  fcmToken             String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  savedScholarships    SavedScholarship[]
  applications         Application[]
  notifications        Notification[]
  supportTickets       SupportTicket[]

  @@map("users")
}

model Scholarship {
  id           String            @id @default(uuid())
  title        String
  description  String
  provider     String
  providerLogo String?
  type         ScholarshipType
  countries    String[]
  fields       String[]
  level        StudyLevel[]
  amount       Float?
  currency     String?           @default("USD")
  deadline     DateTime
  startDate    DateTime?
  duration     String?
  link         String
  requirements String?
  benefits     String[]
  languages    String[]
  isActive     Boolean           @default(true)
  isFeatured   Boolean           @default(false)
  views        Int               @default(0)

  // ← Champs scraping
  status       ScholarshipStatus @default(APPROVED)
  source       String?
  scrapedAt    DateTime?
  verifiedBy   String?
  verifiedAt   DateTime?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  savedBy      SavedScholarship[]
  applications Application[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([deadline])
  @@index([status])     // ← nouveau
  @@map("scholarships")
}

model SavedScholarship {
  id            String   @id @default(uuid())
  userId        String
  scholarshipId String
  savedAt       DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
  @@index([userId])
  @@index([scholarshipId])
  @@map("saved_scholarships")
}

model Application {
  id            String            @id @default(uuid())
  userId        String
  scholarshipId String
  status        ApplicationStatus @default(SAVED)
  notes         String?
  appliedAt     DateTime?
  updatedAt     DateTime          @updatedAt
  createdAt     DateTime          @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
  @@index([userId, status])
  @@index([scholarshipId, status])
  @@map("applications")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  body      String
  type      NotificationType
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  subject   String
  message   String
  reply     String?
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("support_tickets")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum StudyLevel {
  BEPC
  BACCALAUREAT
  LICENCE_1
  LICENCE_2
  LICENCE_3
  LICENCE
  MAITRISE
  MASTER_1
  MASTER_2
  MASTER
  DOCTORAT_1
  DOCTORAT_2
  DOCTORAT
}

enum ScholarshipType {
  COMPLETE
  PARTIELLE
  RECHERCHE
  FORMATION
}

enum ScholarshipStatus {
  PENDING    // scrapée, en attente de validation admin
  APPROVED   // validée et visible dans l'app
  REJECTED   // rejetée
}

enum ApplicationStatus {
  SAVED
  EN_COURS
  SOUMISE
  ACCEPTEE
  REFUSEE
}

enum NotificationType {
  NEW_SCHOLARSHIP
  DEADLINE_REMINDER
  APPLICATION_UPDATE
  SUPPORT_REPLY
  SYSTEM
  EVENING_REMINDER   // ← nouveau pour le cron 20h
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}
